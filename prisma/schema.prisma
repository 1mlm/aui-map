generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tag {
  id        String  @id
  label     String
  // key into the app's icon registry (src/map/iconRegistry.ts) — a HugeIcon's
  // path data isn't something postgres can hold, so only the lookup key is stored
  icon      String
  color     String?
  // pin size multiplier — 1 (normal) for buildings, smaller (e.g. 0.8) for things like food
  // stands or auditoriums that sit inside/next to a building and shouldn't compete with it visually
  sizeScale Float   @default(1)
  pins      Pin[]
}

model Pin {
  // the real, stable identity — never shown, never edited. Attachment/Submission point at this
  // instead of id, so renaming a pin's public slug can't orphan its photos or break a relation
  uuid         String       @id @default(uuid())
  // the short public slug (m6l, b4, ...) used in #id links and shown/settable in the admin —
  // just @unique now instead of the primary key, so it's free to rename
  id           String       @unique
  title        String
  aliases      String[]
  description  String?
  latitude     Float
  longitude    Float
  // curated place link (reviews/photos) some pins get by hand — overrides the
  // coordinate-search link the maps menu would otherwise build. https-only, checked in upsertPin
  mapsUrl      String?
  // freeform, e.g. "Mon-Thu 8am-12am, Fri 8am-6pm" — formats vary too much per place for a
  // structured schedule to be worth it. ramadanHours only shown (via a small reveal) when set
  hours        String?
  ramadanHours String?
  phone        String?
  email        String?
  // arbitrary named links (Instagram, a menu PDF, an external site...) — {label, url}[].
  // shape isn't fixed enough per-pin to earn its own table, and it's small/admin-only data
  links        Json         @default("[]")
  // replaces the old "In construction" tag — a pin keeps its real category (academic, housing...)
  // and just gets a small in-progress cue overlaid on top, instead of losing that category
  underConstruction Boolean @default(false)
  tagId        String
  tag          Tag          @relation(fields: [tagId], references: [id])
  attachments  Attachment[]
  submissions  Submission[]
  qrCodes      QrCode[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Attachment {
  id          String   @id @default(cuid())
  url         String
  // null on attachments created before file-type support existed — those are all images,
  // so render code treats a null mimeType as "image/*" rather than backfilling a lie
  mimeType    String?
  fileName    String?
  caption     String?
  // at most one true per pin, enforced in the server action rather than the
  // schema — a partial unique index isn't expressible in Prisma's declarative syntax
  isThumbnail Boolean  @default(false)
  // manual admin ordering within a pin's gallery, independent of postedAt
  order       Int      @default(0)
  postedAt    DateTime @default(now())
  pinId       String
  pin         Pin      @relation(fields: [pinId], references: [uuid], onDelete: Cascade)
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// what a visitor was actually trying to contribute. Everything used to be an ATTACHMENT because
// a file for an existing pin was the only thing the UI could send — the other three arrive from
// the contribute picker, and each one leaves a different set of columns empty
enum SubmissionKind {
  ATTACHMENT
  PANORAMA
  NEW_PIN
  PIN_EDIT
}

// a visitor-contributed file for a pin — a photo, but also a video, a menu PDF, a floor plan,
// a spreadsheet, whatever. Approving one promotes it into that pin's Attachment gallery, typed
// and rendered per its mimeType
model Submission {
  id          String           @id @default(cuid())
  kind        SubmissionKind   @default(ATTACHMENT)
  // null for a NEW_PIN, which is a request for a pin that doesn't exist yet
  pinId       String?
  pin         Pin?             @relation(fields: [pinId], references: [uuid], onDelete: Cascade)
  // null for the text-only kinds (NEW_PIN, PIN_EDIT) — those carry `message` instead
  fileUrl     String?
  fileName    String?
  mimeType    String?
  caption     String?
  // what the contributor wrote: the pitch for a new pin, or what's wrong with an existing one
  message     String?
  // where a NEW_PIN or PANORAMA should sit. Kept off the Pin/Panorama tables until an admin
  // approves it, so an unreviewed guess never shows up on the map
  latitude    Float?
  longitude   Float?
  title       String?
  // true when the PANORAMA came from the in-app spherical capture flow rather than a plain
  // uploaded file, carried through to Panorama.spherical on approve
  spherical   Boolean          @default(false)
  status      SubmissionStatus @default(PENDING)
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?
}

// a trackable QR/short-link instance for a pin — separate from Pin.id (which also works as a
// plain short link) so a scan can be attributed to a specific printed poster/flyer rather than
// just "someone visited this pin's page". pinId points at uuid, not the renameable public slug,
// same reasoning as Attachment/Submission above
model QrCode {
  // the code embedded in the QR / printed on the link — generated once and permanent, since a
  // printed poster can't be updated after the fact
  id        String        @id
  // set by an admin to tell instances of the same pin's QR apart ("front door poster", ...);
  // null for the default one auto-created the first time someone opens a pin's QR code
  label     String?
  pinId     String
  pin       Pin           @relation(fields: [pinId], references: [uuid], onDelete: Cascade)
  createdAt DateTime      @default(now())
  events    QrCodeEvent[]
}

enum QrCodeEventType {
  CREATED
  RENAMED
  SCANNED
}

// chronological audit log for a QrCode — mirrors riad-stone's HistoryEvent shape (enum type +
// freeform data blob) rather than separate tables per event kind, since the event set is small
// and admin history views just want one ordered timeline
model QrCodeEvent {
  id        String          @id @default(cuid())
  qrCodeId  String
  qrCode    QrCode          @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  type      QrCodeEventType
  // RENAMED stores { before, after }; CREATED/SCANNED carry no extra data
  data      Json            @default("{}")
  createdAt DateTime        @default(now())

  @@index([createdAt])
}

// general feedback/bug reports from the bulb icon on the public map — not tied to a pin
// feedback about the app itself, as opposed to a Submission, which is about the map's contents
enum SuggestionKind {
  BUG
  FEATURE
}

model Suggestion {
  id          String   @id @default(cuid())
  kind        SuggestionKind @default(FEATURE)
  message     String
  // an optional attachment (screenshot, etc.) — most feedback is text-only, hence nullable
  fileUrl     String?
  fileName    String?
  mimeType    String?
  submittedAt DateTime @default(now())
  resolved    Boolean  @default(false)
}

// a photo of campus placed at a coordinate, deliberately not attached to a Pin — panoramas are
// about the space between buildings, so forcing an owner pin would misfile them. Either a wide
// flat photo (scrolled horizontally, no viewer dependency) or a full spherical capture (an
// equirectangular image, rendered inside a sphere), see `spherical`
model Panorama {
  uuid      String   @id @default(uuid())
  url       String
  // small standin loaded with the map; the full file only downloads when someone opens one
  thumbnailUrl String
  caption   String?
  // which way the camera was facing, in degrees clockwise from north. Flat panoramas don't need
  // it to render — it's stored because it's impossible to recover later if it isn't captured now
  heading   Float?
  // true when `url` is a full equirectangular sphere from the in-app capture flow, rendered with
  // PanoramaCapture's SphereViewer instead of PanoramaLayer's flat scroller
  spherical Boolean  @default(false)
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
